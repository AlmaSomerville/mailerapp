{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/sweep",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/well-known-oauth-as" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/well-known-oauth-prm" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/well-known-oauth-prm" }
  ]
}
